OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional secure permanent-storage webhook for webinar registrations.
# Configure in the production host; never expose these values in frontend code.
WEBINAR_STORAGE_WEBHOOK_URL=
WEBINAR_STORAGE_WEBHOOK_TOKEN=

# Transactional email: verify testnova.in with Resend before using this sender.
RESEND_API_KEY=
WEBINAR_EMAIL_FROM=TestNova <webinar@testnova.in>
WEBINAR_ADMIN_EMAIL=admin@testnova.in
